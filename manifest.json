{
  "manifest_version": 3,
  "name": "Duero Flow Auto",
  "description": "Otomatisasi Google Flow",
  "version": "1.0.0",
  "action": {
    "default_title": "Buka Duero Flow Auto"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://veo.genaipro.vn/*",
    "https://autoflow.dangduc131.workers.dev/*"
  ],
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "side_panel": {
    "default_path": "gateway.html"
  }
}
